# Configuration for MCP Web UI
# Copy this to .env and update values for your environment

# Web UI Backend Server
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8000

# IT Lead Server
IT_LEAD_HOST=127.0.0.1
IT_LEAD_PORT=3061

# Git Repository Server (where code is actually stored)
GIT_SERVER_HOST=192.168.51.187
GIT_SERVER_PORT=22
GIT_REPO_PATH=/home/sorokin/mcp-results

# Web UI Public URL (for generating links accessible from other computers)
# Update this to match your Web UI server's IP
WEB_UI_PUBLIC_URL=http://192.168.51.1:8000

# PostgreSQL for Registry
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=mcp_registry
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
