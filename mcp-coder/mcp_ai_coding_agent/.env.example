# Configuration for AI Coding Agent
# This file contains the settings for connecting to the LLM service

# LLM Service Configuration
LLM_BASE_URL=http://localhost:1234/v1  # Change this to your actual LLM service endpoint
LLM_API_KEY=not-needed-for-local-llm    # API key if required by your LLM service
LLM_MODEL_NAME=qwen3-4b                # Model name to use

# Server Configuration
SERVER_HOST=127.0.0.1                  # Host for the AI Coding Agent server
SERVER_PORT=3050                       # Port for the AI Coding Agent server