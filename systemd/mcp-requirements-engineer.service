[Unit]
Description=MCP Requirements Engineer Server - Requirements Analysis
Documentation=https://github.com/your-org/mcp-system
After=network.target mcp-registry.service
Wants=mcp-registry.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/qwen/base/requirements-engineer-mcp-server/requirement-engineer-mcp-server
EnvironmentFile=/root/qwen/base/.env

# Environment defaults
Environment="TRANSPORT=streamable-http"
Environment="HOST=0.0.0.0"
Environment="PORT=3062"
Environment="USE_POSTGRES=true"
Environment="LLM_PROVIDER_URL=http://192.168.51.237:1234/v1/chat/completions"
Environment="LLM_MODEL=qwen3-coder-next@q5_k_xl"

# Start the requirements engineer server
ExecStart=/bin/bash -c 'source /root/qwen/base/.env 2>/dev/null || true; \
    python requirement_engineer_server.py \
        --transport ${TRANSPORT:-streamable-http} \
        --host ${WEB_UI_HOST:-0.0.0.0} \
        --port ${REQUIREMENTS_PORT:-3062} \
        --register-with-registry \
        --registry-host ${REGISTRY_HOST:-127.0.0.1} \
        --registry-port ${REGISTRY_PORT:-3031} \
        --use-postgres \
        --postgres-host ${POSTGRES_HOST:-127.0.0.1} \
        --postgres-db ${POSTGRES_DB:-mcp_registry} \
        --postgres-user ${POSTGRES_USER:-postgres} \
        --postgres-password ${POSTGRES_PASSWORD:-postgres} \
        --max-concurrent-requests ${MAX_CONCURRENT_REQUESTS:-10} \
        --llm-provider-url ${LLM_PROVIDER_URL} \
        --llm-model ${LLM_MODEL}'

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-requirements

# Resource limits
MemoryMax=1G
CPUQuota=100%

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp /root/qwen/base/logs

[Install]
WantedBy=multi-user.target
