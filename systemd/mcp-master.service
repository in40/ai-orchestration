[Unit]
Description=MCP Master Orchestration Service - Starts all MCP servers
Documentation=https://github.com/your-org/mcp-system
After=network.target postgresql.service
Wants=postgresql.service
# Dependencies on individual services (they will be started together)
Requires=mcp-registry.service
After=mcp-registry.service

[Service]
Type=oneshot
User=root
RemainAfterExit=yes

# This service acts as a master orchestrator that pulls in all MCP services
# The actual work is done by the individual service units
ExecStart=/bin/true
ExecStop=/usr/bin/systemctl stop mcp-web-ui-frontend.service mcp-web-ui-backend.service mcp-devops-release-engineer.service mcp-team-management.service mcp-it-lead.service mcp-requirements-engineer.service mcp-implementation-engineer.service mcp-registry.service

# Install all child services
# Note: Use 'systemctl enable mcp-master' to enable all services

[Install]
WantedBy=multi-user.target
Also=mcp-registry.service
Also=mcp-implementation-engineer.service
Also=mcp-requirements-engineer.service
Also=mcp-it-lead.service
Also=mcp-team-management.service
Also=mcp-devops-release-engineer.service
Also=mcp-web-ui-backend.service
Also=mcp-web-ui-frontend.service
