[Unit]
Description=MCP Master Orchestration Service - Starts all MCP servers
Documentation=https://github.com/in40/ai-orchestration
After=network.target mcp-security-reviewer.service mcp-qa-engineer.service postgresql.service mcp-registry.service mcp-implementation-engineer.service mcp-requirements-engineer.service mcp-it-lead.service mcp-team-management.service mcp-devops-release-engineer.service mcp-web-ui-frontend.service
Wants=postgresql.service
# Reverse dependencies: stopping mcp-master stops all of these.
# mcp-web-ui-backend is intentionally excluded: mcp-web-ui-watchdog owns port 8000.
Requires=mcp-registry.service
Requires=mcp-implementation-engineer.service
Requires=mcp-requirements-engineer.service
Requires=mcp-it-lead.service
Requires=mcp-team-management.service
Requires=mcp-devops-release-engineer.service
Requires=mcp-web-ui-frontend.service
Requires=mcp-qa-engineer.service
Requires=mcp-security-reviewer.service

[Service]
Type=oneshot
User=root
RemainAfterExit=yes
ExecStart=/bin/true
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
Also=mcp-registry.service
Also=mcp-implementation-engineer.service
Also=mcp-requirements-engineer.service
Also=mcp-it-lead.service
Also=mcp-team-management.service
Also=mcp-devops-release-engineer.service
Also=mcp-web-ui-frontend.service
Also=mcp-qa-engineer.service
Also=mcp-security-reviewer.service
