[Unit]
Description=MCP Team Management Server - Team Coordination
Documentation=https://github.com/your-org/mcp-system
After=network.target mcp-registry.service
Wants=mcp-registry.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/qwen/base/team-management-ui/team-management-mcp-server
EnvironmentFile=/root/qwen/base/.env

# Environment defaults
Environment="TRANSPORT=streamable-http"
Environment="HOST=0.0.0.0"
Environment="PORT=3063"
Environment="USE_POSTGRES=true"
Environment="ENABLE_REGISTRY=false"
Environment="LLM_PROVIDER_URL=http://192.168.51.237:1234/v1/chat/completions"
Environment="LLM_MODEL=qwen3.5-35b-a3b@q5_k_xl"

# Start the team management server (uses venv)
ExecStart=/bin/bash -c 'source /root/qwen/base/.env 2>/dev/null || true; \
    source venv/bin/activate; \
    python -m mcp_std_server.team_management_server \
        --transport ${TRANSPORT:-streamable-http} \
        --host ${WEB_UI_HOST:-0.0.0.0} \
        --port ${TEAM_PORT:-3063} \
        --register-with-registry \
        --registry-host ${REGISTRY_HOST:-127.0.0.1} \
        --registry-port ${REGISTRY_PORT:-3031} \
        --use-postgres \
        --postgres-host ${POSTGRES_HOST:-localhost} \
        --postgres-port ${POSTGRES_PORT:-5432} \
        --postgres-db ${POSTGRES_DB:-mcp_registry} \
        --postgres-user ${POSTGRES_USER:-postgres} \
        --postgres-password ${POSTGRES_PASSWORD:-} \
        --max-concurrent-requests ${MAX_CONCURRENT_REQUESTS:-10}'

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=60

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-team-management

# Resource limits
MemoryMax=512M
CPUQuota=80%

# Security hardening
NoNewPrivileges=true
ReadWritePaths=/tmp /root/qwen/base/logs

[Install]
WantedBy=multi-user.target
