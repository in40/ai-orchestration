/* MCP Explorer TUI Styles */
Screen {
    background: $surface;
}

#main-layout {
    height: 1fr;
    border: solid $primary;
}

#left-panel {
    width: 1fr;
    border-right: solid $primary;
}

#right-panel {
    width: 2fr;
}

#registry-header, #tools-header {
    background: $primary;
    color: $text;
    padding: 0 1;
    text-style: bold;
}

Tree {
    height: 1fr;
    border: none;
}

DataTable {
    height: 1fr;
    border: none;
}

Footer {
    dock: bottom;
}

/* Modal styles */
#add-registry-modal, #tool-form-modal {
    align: center middle;
    width: 60%;
    height: 70%;
    border: solid $primary;
    background: $surface;
    padding: 1;
}

#modal-title {
    text-style: bold;
    background: $primary;
    color: $text;
    padding: 0 1;
    margin-bottom: 1;
}

#results-container-wrapper {
    height: 1fr;
    max-height: 20;
    border: solid $secondary;
    background: $boost;
    padding: 1;
    margin: 1 0;
    overflow-y: auto;
}

#results-container {
    width: 100%;
    height: 100%;
    overflow-y: auto;
}

#results-display {
    width: 100%;
    height: 100%;
    text-style: none;
    text-opacity: 1;
    border: solid $secondary;
    background: $boost;
    padding: 1;
    overflow-y: auto;
    height: 100%;
    text-align: left;
    align: center top;
}

Static#results-display {
    width: 100%;
    height: 100%;
    text-style: none;
    text-opacity: 1;
    border: solid $secondary;
    background: $boost;
    padding: 1;
    overflow-y: auto;
    height: 100%;
    text-align: left;
    align: center top;
}

#results-display:focus {
    border: tall $accent;
}

#results-table {
    width: 100%;
    height: 100%;
}

#form-buttons {
    align-horizontal: center;
}

#connection-error-container {
    align: center middle;
    width: 100%;
    height: 100%;
    text-align: center;
}

#error-message {
    text-align: center;
    margin: 2 0;
    color: $error;
}

#error-buttons {
    align: center middle;
    margin-top: 1;
}

#modal-buttons, #error-buttons, #form-buttons {
    align: center middle;
    margin-top: 1;
}

Button {
    margin: 0 1;
}