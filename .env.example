# MCP Orchestration System Configuration
# Copy this file to .env and update values for your environment
# 
# This file contains ALL configuration settings for the MCP system.
# Settings can be overridden by environment variables.
#
# ============================================================================

# ============================================================================
# NETWORK CONFIGURATION
# ============================================================================

# Local network domain (for multi-computer setups)
# Change this to match your network (e.g., 192.168.1.0/24)
NETWORK_DOMAIN=192.168.51.0/24

# ============================================================================
# SERVER PORTS
# ============================================================================

# MCP Registry Server - Service discovery
REGISTRY_PORT=3031

# Implementation Engineer - Code generation
IMPLEMENTATION_PORT=3060

# Requirements Engineer - Requirements analysis
REQUIREMENTS_PORT=3062

# IT Lead Server - Task routing and planning
IT_LEAD_PORT=3061

# Team Management - Team coordination
TEAM_PORT=3063

# DevOps Release Engineer - Deployment
DEVOPS_PORT=3071

# Document Store - Document management
DOCUMENT_STORE_PORT=3070

# Web UI Backend - API server
WEB_UI_BACKEND_PORT=8000

# Web UI Frontend - Development server (Vite)
WEB_UI_FRONTEND_PORT=5173

# ============================================================================
# SERVER HOSTS
# ============================================================================

# Registry Server host
# Use 127.0.0.1 for local-only, 0.0.0.0 for network access
REGISTRY_HOST=127.0.0.1

# IT Lead Server host
IT_LEAD_HOST=127.0.0.1

# Web UI Backend host
# Use 0.0.0.0 to allow access from other computers
WEB_UI_HOST=0.0.0.0

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================

# Database host (PostgreSQL server)
POSTGRES_HOST=127.0.0.1

# Database port
POSTGRES_PORT=5432

# Database name
POSTGRES_DB=mcp_registry

# Database username
POSTGRES_USER=postgres

# Database password
# ⚠️ CHANGE THIS IN PRODUCTION!
POSTGRES_PASSWORD=postgres

# Use PostgreSQL (true) or SQLite (false)
USE_POSTGRES=true

# ============================================================================
# LLM CONFIGURATION
# ============================================================================

# LLM API endpoint URL
# This points to your LM Studio or other LLM server
LLM_PROVIDER_URL=http://192.168.51.237:1234/v1/chat/completions

# LLM model name
# Must match the model loaded in your LLM server
LLM_MODEL=qwen3.5-35b-a3b@q5_k_xl

# Default temperature for LLM generation (0.0-1.0)
# Lower = more deterministic, Higher = more creative
LLM_TEMPERATURE=0.3

# ============================================================================
# GIT REPOSITORY
# ============================================================================

# Git server hostname or IP address
GIT_SERVER_HOST=192.168.51.187

# Git server SSH port
GIT_SERVER_PORT=22

# Path to repository on Git server
GIT_REPO_PATH=/home/sorokin/mcp-results

# Full Git repository URL (for cloning)
# Format: ssh://user@host/path/to/repo.git
GIT_REPO_URL=ssh://sorokin@192.168.51.187/home/sorokin/mcp-results.git

# Local path to Git repository clone
# Used by Web UI backend to serve files
GIT_LOCAL_CLONE_PATH=/tmp/mcp-vibe-coding-git/repo

# ============================================================================
# WEB UI CONFIGURATION
# ============================================================================

# Public URL for Web UI backend
# This is the URL users will access from their browsers
# Change to match your server's IP address for network access
# Example: http://192.168.51.50:8000
WEB_UI_PUBLIC_URL=http://192.168.51.1:8000

# Public URL for Web UI frontend
WEB_UI_FRONTEND_URL=http://192.168.51.1:5173

# ============================================================================
# PERFORMANCE & LIMITS
# ============================================================================

# Maximum concurrent requests per server
MAX_CONCURRENT_REQUESTS=10

# HTTP request timeout in seconds
REQUEST_TIMEOUT=120

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=50

# ============================================================================
# LOGGING
# ============================================================================

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Directory for log files
LOG_DIR=/tmp

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable service registry (for service discovery)
ENABLE_REGISTRY=true

# Auto-register servers with registry on startup
REGISTER_WITH_REGISTRY=true

# ============================================================================
# PATHS
# ============================================================================

# Base directory for MCP system
BASE_DIR=/root/qwen/base

# Data directory for storage
DATA_DIR=/root/qwen/base/data

# ============================================================================
# USAGE EXAMPLES
# ============================================================================
#
# Single Computer Setup (localhost):
#   - Keep REGISTRY_HOST=127.0.0.1
#   - Keep IT_LEAD_HOST=127.0.0.1
#   - Set WEB_UI_HOST=127.0.0.1
#   - Set WEB_UI_PUBLIC_URL=http://localhost:8000
#
# Multi-Computer Setup (network):
#   - Set WEB_UI_HOST=0.0.0.0 (allow network access)
#   - Set WEB_UI_PUBLIC_URL=http://YOUR_SERVER_IP:8000
#   - Keep other hosts as 127.0.0.1 (local services)
#   - Update GIT_SERVER_HOST to your Git server IP
#
# Docker Deployment:
#   - Set POSTGRES_HOST to database container name
#   - Set all hosts to 0.0.0.0
#   - Use environment variables to override
#
# ============================================================================
