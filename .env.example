# MCP Orchestration System - Local Configuration
# This file is gitignored - customize your settings here

# Network
NETWORK_DOMAIN=<value>

# Server Ports (defaults)
REGISTRY_PORT=<value>
IMPLEMENTATION_PORT=<value>
REQUIREMENTS_PORT=<value>
IT_LEAD_PORT=<value>
TEAM_PORT=<value>
DEVOPS_PORT=<value>
DOCUMENT_STORE_PORT=<value>
WEB_UI_BACKEND_PORT=<value>
WEB_UI_FRONTEND_PORT=<value>

# Server Hosts
REGISTRY_HOST=<value>
IT_LEAD_HOST=<value>
WEB_UI_HOST=<value>

# PostgreSQL
POSTGRES_HOST=<value>
POSTGRES_PORT=<value>
POSTGRES_DB=<value>
POSTGRES_USER=<value>
POSTGRES_PASSWORD=<value>
USE_POSTGRES=<value>

# LLM
LLM_PROVIDER_URL=<value>
#LLM_MODEL=<value>
#LLM_MODEL=<value>
#LLM_MODEL=<value>
LLM_MODEL=<value>
# mistral-small-4-119b-2603
# LLM_TEMPERATURE=<value>

# Git Repository
GIT_SERVER_HOST=<value>
GIT_SERVER_PORT=<value>
GIT_REPO_PATH=<value>
GIT_REPO_URL=<value>
GIT_LOCAL_CLONE_PATH=<value>
MCP_GIT_REPO_URL=<value>

# Web UI
WEB_UI_PUBLIC_URL=<value>
WEB_UI_FRONTEND_URL=<value>

# Deployment Host (for containerized applications)
DEPLOYMENT_HOST=<value>

# Performance
MAX_CONCURRENT_REQUESTS=<value>
REQUEST_TIMEOUT=<value>
MAX_FILE_SIZE_MB=<value>

# Logging
LOG_LEVEL=<value>
LOG_DIR=<value>

# Features
ENABLE_REGISTRY=<value>
REGISTER_WITH_REGISTRY=<value>

# Paths
BASE_DIR=<value>
DATA_DIR=<value>

OPENCODE_SERVE_URL=<value>
OPENCODE_SERVE_PASSWORD=<value>

# GitHub PAT for product publishing (user in40)
=<github personal access token, user in40>
OPENCODE_PASSWORD=<value>
